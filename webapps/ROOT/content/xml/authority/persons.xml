<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Authority List of Persons attested in MedCyprus</title>
            </titleStmt>
            <publicationStmt><ab/></publicationStmt>
            <sourceDesc><ab/></sourceDesc>
        </fileDesc>
    </teiHeader>
    <text>
        <body>
            <div type="commentary">
                <listPerson>
                    
                    <person xml:id="AlexiosKomnenos">
                        <persName xml:lang="en"><forename>Alexios I</forename> <surname>Komnenos</surname></persName>
                        <persName xml:lang="grc"><forename>Ἀλέξιος</forename> <surname>Κομνηνός</surname></persName>       
                        <birth  notBefore="1050" notAfter="1057">ca 1057</birth>
                        <death when="1118">1118</death>                       
                        <floruit from="1081" to="1118">reign 1081-1118</floruit>
                        <occupation type="office-secular" xml:lang="en">emperor</occupation>
                        <occupation type="office-secular" xml:lang="grc">βασιλεύς</occupation>
                        <note>The church of Panagia Phorbiotissa or Asinou, Niketari, was first decorated with murals during his reign (1105/6).</note>
                        <idno type="wikidata">https://www.wikidata.org/wiki/Q41600</idno>
                        <idno type="PBW">http://pbw2016.kdl.kcl.ac.uk/person/Alexios/1/</idno>
                    </person>
                    
                    <person xml:id="AnastasiaSaramalyna">
                        <persName xml:lang="en"><forename>Anastasia</forename> <surname>Saramalyna</surname></persName>
                        <persName xml:lang="grc"><forename>Ἀναστασία</forename> <surname>Σαραμαλύνα</surname></persName>
                        <floruit notBefore="1201" notAfter="1300">13th century</floruit>                
                        <note>Donor of the mural panel of St Anastasia the Poison-curer in the narthex of Panagia Phorbiotissa or Asinou, Niketari</note>
                        <idno type="PLP">#24868 (Σαραμαλίνα Ἀναστασία)</idno>
                    </person>
                    
                    <person xml:id="Authentes">
                        <persName xml:lang="en"><forename>Authentes</forename></persName>
                        <persName xml:lang="grc"><forename>Αὐθέντης</forename></persName>
                        <floruit notBefore="1101" notAfter="1200">12th century</floruit>
                        <note>Father of the donor of the 1192 murals of Panagia tou Araka or Arakiotissa, Lagoudera</note>
                    </person>
                    <relation active="#Authentes" ref="snap:fatherOf" passive="#LeonAuthentes">
                        <desc>father of Leon Authentes</desc>
                    </relation>
                                        
                    <person xml:id="ChristophorosΟmotes">
                        <persName xml:lang="en"><forename>Christophoros</forename> <surname>Οmotes</surname></persName>
                        <persName xml:lang="grc"><forename>Χριστοφόρος</forename> <surname>Ὀμότης</surname></persName>
                        <floruit notBefore="1201" notAfter="1300">13th century</floruit>                
                        <note>Donor of the mural panel of St Christopher in the naos of Panagia, Moutoullas, along with his wife (1280)</note>
                        <idno type="PLP">#21058</idno>
                    </person>
                    <relation active="#ChristophorosΟmotes" ref="snap:husbandOf" passive="#Maria_1">
                        <desc>husband of Maria</desc>
                    </relation>
                    
                    <person xml:id="Eirene_1">
                        <persName xml:lang="en"><forename>Eirene</forename></persName>
                        <persName xml:lang="grc"><forename>Εἰρήνη</forename></persName>
                        <floruit notBefore="1201" notAfter="1300">13th century</floruit>                     
                        <note>Founder of the church of Panagia, Moutoullas, and donor of its 1280 murals, along with her husband</note>
                    </person>
                   <relation active="#Eirene_1" ref="snap:wifeOf" passive="#IoannesGerakiotes">
                        <desc>wife of Ioannes Gerakiotes or Moutoullas</desc>
                    </relation>
                    
                    <person xml:id="Eirene_2">
                        <persName xml:lang="en"><forename>Eirene</forename></persName>
                        <persName xml:lang="grc"><forename>Εἰρήνη</forename></persName>
                        <floruit notBefore="1201" notAfter="1300">13th century</floruit>                     
                        <note>Donor of the mural panel of Christ enthroned in the ambulatory of Panagia, Moutoullas, along with her husband (1280)</note>
                    </person>
                    <relation active="#Eirene_2" ref="snap:wifeOf" passive="#GeorgiosKompotes">
                        <desc>wife of Georgios Kompotes</desc>
                    </relation>
                    
                    <person xml:id="EumathiosPhilokales">
                        <persName xml:lang="en"><forename>Eumathios</forename> <surname>Philokales</surname></persName>
                        <persName xml:lang="grc"><forename>Εὐμάθιος</forename> <surname>Φιλοκάλης</surname></persName>
                        <birth  notBefore="1050" notAfter="1070">around the middle of the 11th century</birth>
                        <death notBefore="1118" notAfter="1150">after 1118</death>                        
                        <floruit from="1092" to="1118">1092-1118</floruit>
                        <occupation type="office-secular" xml:lang="en">military governor of Cyprus</occupation>
                        <occupation type="office-secular" xml:lang="grc">δοὺξ Κύπρου</occupation>
                        <occupation type="dignity" xml:lang="en">protonobelissimos</occupation>
                        <occupation type="dignity" xml:lang="grc">πρώτιστος νωβελλισίμων</occupation>
                        <note>Founder and donor of the wall-painted decoration of the Holy Trinity chapel, Monastery of St John Chrysostom, Koutsovendes (ca 1100)</note>
                        <idno type="wikidata">https://www.wikidata.org/wiki/Q928648</idno>
                        <idno type="PBW">http://pbw2016.kdl.kcl.ac.uk/person/Eumathios/102/</idno>
                    </person>
                    
                    <person xml:id="Georgios_1">
                        <persName xml:lang="en"><forename>Georgios</forename></persName>
                        <persName xml:lang="grc"><forename>Γεώργιος</forename></persName>
                         <floruit notBefore="1100" notAfter="1200">12th century</floruit>
                        <occupation type="status_ecclesiastical" xml:lang="en">priest</occupation>
                        <occupation type="status_ecclesiastical" xml:lang="grc">ἱερεύς</occupation>
                        <note>Responsible for the restoration and decoration with wall-paintings of the church of the Holy Cross, Pelendri, along with his fellow priests (1177/8)</note>
                    </person>
                    <relation active="#Georgios_1" ref="snap:coDonorWith" passive="#priests_anonymous">
                        <desc>co-donor with other priests</desc>
                    </relation>
                    
                    <person xml:id="GeorgiosKompotes">
                        <persName xml:lang="en"><forename>Georgios</forename> <surname>Kompotes</surname></persName>
                        <persName xml:lang="grc"><forename>Γεώργιος</forename> <surname>Κομπότης</surname></persName>
                        <floruit notBefore="1201" notAfter="1300">13th century</floruit>                
                        <note>Donor of the mural panel of Christ enthroned in the ambulatory of Panagia, Moutoullas, along with his wife (1280)</note>
                    </person>
                    <relation active="#GeorgiosKompotes" ref="snap:husbandOf" passive="#Eirene_2">
                        <desc>husband of Eirene</desc>
                    </relation>
                    
                    <person xml:id="Gephyra">
                        <persName xml:lang="en"><forename>Gephyra</forename></persName>
                        <persName xml:lang="grc"><forename>Γέφυρα</forename></persName>
                       <floruit notAfter="1106">late 11th century - early 12th century</floruit>                     
                        <note>Her death was commemorated with an inscription and a portrait originally as part of the 1105/6 murals of Panagia Phorbiotissa or Asinou, Niketari</note>
                    </person>
                    <relation active="#Gephyra" ref="snap:wifeOf" passive="#NikephorosIschyrios">
                        <desc>familial connection to Nikephoros Ischyrios (wife, daughter, or other)</desc>
                    </relation>
                                     
                    <!--<person xml:id="Germanos">
                        <persName xml:lang="en"><forename>Germanos</forename></persName>
                        <persName xml:lang="grc"><forename>Γερμανός</forename></persName>
                        <note>hieromonk of the monastery of Saint Nicholas the Roof at Kakopetria</note>
                        <floruit notBefore="..." notAfter="...">...</floruit>
                        <occupation type="occupation">hieromonk</occupation>
                        <idno type="wikidata"></idno>
                        <idno type="PBW">...</idno>
                    </person>-->
                    
                    <person xml:id="IoannesGerakiotes">
                        <persName xml:lang="en"><forename>Ioannes</forename> <surname>Gerakiotes</surname> <surname>Moutoullas</surname></persName>
                        <persName xml:lang="grc"><forename>Ἰωάννης</forename> <surname>Γερακιώτης</surname> <surname>Μουτουλλᾶς</surname></persName>
                        <floruit notBefore="1201" notAfter="1300">13th century</floruit>                     
                        <note>Founder of the church of Panagia, Moutoullas, and donor of its 1280 murals, along with his wife Eirene</note>
                        <idno type="PLP">#21058</idno>
                    </person>
                        <relation active="#IoannesGerakiotes" ref="snap:husbandOf" passive="#Eirene_1">
                            <desc>husband of Eirene</desc>
                        </relation>
                                        
                    <!--<person xml:id="Ioannes_1">
                        <persName xml:lang="en"><forename>Ioannes</forename><surname>Kappadokas</surname></persName>
                        <persName xml:lang="grc"><forename>Ἰωάννης</forename> <surname>Καππάδοξ</surname></persName>
                        <note>donor of the monastery of Saint Nicholas the Roof at Kakopetria</note>
                        <floruit notBefore="..." notAfter="...">...</floruit>
                        <occupation type="occupation">...</occupation>
                        <idno type="wikidata"></idno>
                        <idno type="PBW">...</idno>
                    </person>-->                    
                                     
                    <person xml:id="IschyrioiFamily">
                        <persName xml:lang="en"><forename>Ischyrioi</forename></persName>
                        <persName xml:lang="grc">Ἰσχύριοι</persName>
                        <floruit  notBefore="1001" notAfter="1100">11th - 12th century</floruit>                                    
                        <note>A member of the Ischyrioi family was the donor of the 1105/6 murals of the church of Panagia Phorbiotissa or Asinou, Niketari</note>
                    </person>
                    <relation active="#IschyrioiFamily" ref="snap:familyOf" passive="#NikephorosIschyrios">
                        <desc>family of Nikephoros Ischyrios</desc>
                    </relation>
                    
                    <person xml:id="Laurentios_1">
                        <persName xml:lang="en"><forename>Laurentios</forename></persName>
                        <persName xml:lang="grc"><forename>Λαυρέντιος</forename></persName>
                        <floruit notBefore="1167" notAfter="1233">late 12th centure - early 13th century</floruit>
                        <occupation type="status-ecclesiastical" xml:lang="en">hieromonk</occupation>
                        <occupation type="status-ecclesiastical" xml:lang="grc">ἱερομόναχος</occupation>
                        <occupation type="office-ecclesiastical" xml:lang="en">abbot</occupation>
                        <occupation type="office-ecclesiastical" xml:lang="grc">καθηγούμενος</occupation>
                        <note>Donor of the church of Saint Ephemianos, Lysi, though the nature of his involvment is unclear</note>
                    </person>
                    
                    <person xml:id="LeonAuthentes">
                        <persName xml:lang="en"><forename>Leon</forename> <surname>Authentes</surname></persName>
                        <persName xml:lang="grc"><forename>Λέων</forename> <surname>Αὐθέντης</surname></persName>                      
                        <floruit notBefore="1134" notAfter="1233">mid-12th - early 13th century</floruit>
                        <occupation type="honorific" xml:lang="en">lord</occupation>                        
                        <occupation type="honorific" xml:lang="grc">κῦρ</occupation>
                        <note>Donor of the 1192 murals of Panagia tou Araka or Arakiotissa, Lagoudera</note> 
                    </person>
                   <relation active="#LeonAuthentes" ref="snap:sonOf" passive="#Authentes">
                        <desc>son of Authentes</desc>
                    </relation>                    
                   
                    <person xml:id="Maria_1">
                        <persName xml:lang="en"><forename>Maria</forename></persName>
                        <persName xml:lang="grc"><forename>Μαρία</forename></persName>
                        <floruit notBefore="1201" notAfter="1300">13th century</floruit>                     
                        <note>Donor of the mural panel of St Christopher in the naos of Panagia, Moutoullas, along with her husband (1280)</note>
                    </person>
                    <relation active="#Maria_1" ref="snap:wifeOf" passive="#ChristophorosΟmotes">
                        <desc>wife of Christophoros Omotes</desc>
                    </relation>
                    
                    <person xml:id="NeophytosRecluse">
                        <persName xml:lang="en"><forename>Neophytos</forename> <surname>the Recluse</surname></persName>
                        <persName xml:lang="grc"><forename>Νεόφυτος</forename> <surname>ὁ Ἔγκλειστος</surname></persName>
                        <birth  when="1134">1134</birth>
                        <death notBefore="1214" notAfter="1250">after 1214</death>  
                        <floruit notBefore="1167" notAfter="1233">late 12th century - early 13th century</floruit>
                        <occupation type="status-ecclesiastical" xml:lang="en">hieromonk, recluse</occupation>
                        <occupation type="status-ecclesiastical" xml:lang="grc">ἱερομόναχος, ἔγκλειστος</occupation>
                        <note>Founder of the Hermitage of Saint Neophytos, Tala, and donor of the first four layers of its painted decoration</note>
                        <idno type="wikidata">https://www.wikidata.org/wiki/Q6993672</idno>
                    </person>
                    
                    <person xml:id="NikephorosIschyrios">
                        <persName xml:lang="en"><forename>Nikephoros</forename> <surname>Ischyrios</surname></persName>
                        <persName xml:lang="grc"><forename>Νικηφόρος</forename> <surname>Ἰσχύριος</surname></persName>    
                        <birth  notBefore="1034" notAfter="1067">around the middle of the 11th century</birth>
                        <death notBefore="1106" notAfter="1133">early 12th century</death>                   
                        <occupation type="dignity" xml:lang="en">magistros</occupation>                        
                        <occupation type="dignity" xml:lang="grc">μάγιστρος</occupation>
                        <note>Donor of the 1105/6 murals of the church of Panagia Phorbiotissa or Asinou, Niketari</note>
                    </person>
                    <relation active="#NikephorosIschyrios" ref="snap:memberOf" passive="#IschyrioiFamily">
                        <desc>member of the Ischyrioi Family</desc>
                    </relation>

                    <person xml:id="NikephorosKallias">
                        <persName xml:lang="en"><forename>Nikephoros</forename> <surname>Kallias</surname></persName>
                        <persName xml:lang="grc"><forename>Νικηφόρος</forename> <surname>Καλλίας or Καλλιάς</surname></persName>
                        <floruit notBefore="1151" notAfter="1200">second half of 12th century</floruit>
                        <occupation type="occupation" xml:lang="en">farrier(?)</occupation>
                        <occupation type="occupation" xml:lang="grc">καλλιγάς(?)</occupation>
                        <note>Supplicant associated with the mural of St George on horseback of Panagia Phorbiotissa or Asinou, Niketari</note>
                    </person>
                    <relation active="#NikephorosKallias" ref="snap:possiblySameAs" passive="#Nikephoros_1">
                        <desc>Possibly the same as Nikephoros, the donor of the mural of Saint George on horseback in the the narthex of Panagia Phorbiotissa or Asinou, Niketari</desc>
                    </relation>
                    
                    <person xml:id="Nikephoros_1">
                        <persName xml:lang="en"><forename>Nikephoros</forename></persName>
                        <persName xml:lang="grc"><forename>Νικηφόρος</forename></persName>
                        <floruit notBefore="1151" notAfter="1200">second half of 12th century</floruit>
                        <occupation type="occupation" xml:lang="en">veterinary doctor</occupation>
                        <occupation type="occupation" xml:lang="grc">ἵππων ἀκεστήρ</occupation>
                        <note>Donor of the late-twelfth century mural of St George on horseback in the the narthex of Panagia Phorbiotissa or Asinou, Niketari</note> 
                    </person>
                    <relation active="#Nikephoros_1" ref="snap:possiblySameAs" passive="#NikephorosKallias">
                        <desc>Possibly the same as the supplicant Nikephoros Kallias</desc>
                    </relation>
                                        
                    <person xml:id="priests_anonymous">
                        <persName xml:lang="en"><forename>Priests</forename></persName>
                        <persName xml:lang="grc"><forename>ἱερεῖς</forename></persName>
                        <floruit notBefore="1100" notAfter="1200">12th century</floruit>
                        <occupation type="status_ecclesiastical" xml:lang="en">priest</occupation>
                        <occupation type="status_ecclesiastical" xml:lang="grc">ἱερεύς</occupation>
                        <note>Anonymous priests of the village of Pelendri, responsible for the restoration and decoration with murals of the local church of the Holy Cross, along with the priest Georgios (1177/8)</note>
                    </person>
                    <relation active="#priests_anonymous" ref="snap:coDonorWith" passive="#Georgios_1">
                        <desc>co-donors with the priest Georgios</desc>
                    </relation>
                    
                    <person xml:id="PelendriPainter">
                        <persName xml:lang="en"><forename>...os</forename> <surname>Monomachos(?)</surname></persName>
                        <persName xml:lang="grc"><forename>...ος</forename> <surname>Μονομάχος(?)</surname></persName>
                        <floruit notBefore="1100" notAfter="1200">12th century</floruit>                        
                        <occupation type="occupation" xml:lang="en">painter</occupation>
                        <occupation type="status_ecclesiastical" xml:lang="en">monk(?)</occupation>
                        <occupation type="status_ecclesiastical" xml:lang="grc">μοναχός(?)</occupation>
                        <note>Painter of the 1177/8 murals of the church of the Holy Cross, Pelendri. His personal name is not preserved, while the surviving designation that accompanies it may be read either as 'Μον(ο)μάχος' (Monomachos) or as 'μον{μ}αχός' (monk)</note>                        
                    </person>
                    
                    <person xml:id="TheodoreApseudes">
                        <persName xml:lang="en"><forename>Theodore</forename> <surname>Apseudes</surname></persName>
                        <persName xml:lang="grc"><forename>Θεόδωρος</forename> <surname>Ἀψευδής</surname></persName>
                        <floruit notBefore="1167" notAfter="1233">late 12th - early 13th century</floruit>                        
                        <occupation type="occupation" xml:lang="en">painter</occupation>
                        <note>Painter of the 1183 murals in the cell and the bema of the Hermitage of Saint Neophytos, Tala</note>
                        <idno type="wikidata">https://www.wikidata.org/wiki/Q108041020</idno>
                       </person>
                    
                </listPerson>
            </div>
        </body>
    </text>
</TEI>